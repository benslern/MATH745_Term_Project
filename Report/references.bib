	issn = {1432-0673},
	url = {https://doi.org/10.1007/s00205-018-1298-1},
	doi = {10.1007/s00205-018-1298-1},
	abstract = {We study a modification due to De Gregorio of the Constantin–Lax–Majda (CLM) model \$\$\{{\textbackslash}omega\_\{t\}\}\$\$= \$\$\{{\textbackslash}omega H{\textbackslash}omega\}\$\$on the unit circle. The De Gregorio equation is \$\$\{{\textbackslash}omega\_\{t\} +u{\textbackslash}omega\_\{x\}-\{u\}\_\{x\}{\textbackslash}omega = 0, \{u\}\_\{x\} = H{\textbackslash}omega \}\$\$. In contrast with the CLM model, numerical simulations suggest that the solutions of the De Gregorio model with smooth initial data exist globally for all time, and generically converge to equilibria when \$\$\{t {\textbackslash}rightarrow {\textbackslash}pm {\textbackslash}infty\}\$\$, in a way resembling inviscid damping. We prove that such behavior takes place near a manifold of equilibria.},
	language = {en},
	number = {2},
	urldate = {2025-11-30},
	journal = {Archive for Rational Mechanics and Analysis},
	author = {Jia, H. and Stewart, S. and Sverak, V.},
	month = feb,
	year = {2019},
	pages = {1269--1304},
	file = {Full Text PDF:C\:\\Users\\bensl\\Zotero\\storage\\ZXYHXL3G\\Jia et al. - 2019 - On the De Gregorio Modification of the Constantin–Lax–Majda Model.pdf:application/pdf},
}

